# ==============================
# SERVER
# ==============================
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# ==============================
# MONGODB ATLAS
# ==============================
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/civicare?retryWrites=true&w=majority

# ==============================
# JWT AUTHENTICATION
# ==============================
JWT_ACCESS_SECRET=replace_with_long_random_access_secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_SECRET=replace_with_long_random_refresh_secret
JWT_REFRESH_EXPIRES=7d
JWT_RESET_SECRET=replace_with_long_random_reset_secret

# ==============================
# CLOUDINARY (Media Uploads)
# ==============================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ==============================
# BREVO (Transactional Email API - used for verification/reset emails)
# Get your API key from Brevo dashboard: Settings > SMTP & API > API Keys
# ==============================
BREVO_API_KEY=your_brevo_api_key
EMAIL_FROM="CiviCare Barangay System <no-reply@civicare.gov.ph>"

# ==============================
# SEMAPHORE SMS API
# ==============================
SEMAPHORE_API_KEY=your_semaphore_api_key
SEMAPHORE_SENDER_NAME=CiviCare

# ==============================
# ADMIN SEED ACCOUNT (used by seeders)
# ==============================
SEED_ADMIN_EMAIL=admin@civicare.gov.ph
SEED_ADMIN_PASSWORD=Admin@12345

# ==============================
# RATE LIMITING
# ==============================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
